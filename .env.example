# DevAppFactory settings. Copy to .env, or run deploy/install-host.sh, which creates .env
# and fills in the first four. Both factory-host (systemd) and factory-app (Docker Compose)
# read this file. Never commit .env.

# --- Required ----------------------------------------------------------------

# Encrypts the environment variables you store for deployments (AES-256-GCM).
# 64 hex characters: openssl rand -hex 32. Keep it: without it, stored variables are unreadable.
FACTORY_SECRET_KEY=

# Where the factory keeps everything: database, kit library, projects, worktrees, deployments, run logs.
FACTORY_HOME=/home/you/factory

# User and group that run factory-host (id -u, id -g). The container uses the same,
# so it can reach the host service's socket.
FACTORY_UID=1000
FACTORY_GID=1000

# --- Gateway and domain ------------------------------------------------------

# Folder of the gateway that publishes sites through scripts/gateway.sh.
# Default: the bundled gateway in $FACTORY_HOME/gateway, set up by deploy/install-gateway.sh.
# Set this only to use a gateway of your own that offers the same commands.
#GATEWAY_DIR=/home/you/my-gateway

# Apps are published as https://<name>.<domain>. deploy/install-gateway.sh writes it.
# Default: DOMAIN from the gateway's own .env.
#FACTORY_DOMAIN=example.com

# Name of the gateway's container, used for health checks. Default: gateway-caddy
#GATEWAY_CONTAINER=gateway-caddy

# Docker network shared by the gateway and the web container of every app. Default: factory-edge
#FACTORY_EDGE_NETWORK=factory-edge

# Docker network on which the gateway reaches the factory's own UI. Default: devappfactory-network
#FACTORY_APP_NETWORK=devappfactory-network

# --- Optional ----------------------------------------------------------------

# GitHub user or organisation that owns created repositories. Default: the account `gh` is logged in as.
#GH_OWNER=

# user@host of this server, for the "Open in VS Code" link. Default: <current user>@factory.<domain>
#FACTORY_SSH_TARGET=you@server.example.com

# Agent runs at the same time. Default: 2
#MAX_CONCURRENT_RUNS=2
